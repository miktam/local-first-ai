# exp_036 environment defaults (BUILD_SPEC §1; RUNBOOK "Every Claude-run block").
# Source it from the experiment directory:
#   cd ~/REPOS/local-first-ai/tasks/chronos/exp_036_kolibri_local_eval && source env/exp036.env
# Works in bash and zsh. Existing values win; a git-ignored env/exp036.local.env
# (never committed) is read first for host overrides, e.g. on the mini:
#   export EXP036_MODELS="$HOME/models/exp036-mini"
#   export PY="$HOME/models/exp036-mini/venv312/bin/python"
# No absolute home path is written here.

if [ -z "${EXP:-}" ] || [ ! -f "${EXP:-/nonexistent}/HYPOTHESIS.md" ]; then
  if [ -f "$PWD/HYPOTHESIS.md" ] && [ -f "$PWD/env/exp036.env" ]; then
    EXP="$PWD"
  else
    echo "exp036.env: source this file from the exp_036 directory (or set EXP)" >&2
    return 1 2>/dev/null || exit 1
  fi
fi
export EXP

if [ -f "$EXP/env/exp036.local.env" ]; then
  . "$EXP/env/exp036.local.env"
fi

export EXP036_MODELS="${EXP036_MODELS:-$HOME/models/exp036}"
export EXP036_DATA="${EXP036_DATA:-$EXP036_MODELS/data}"
export EXP036_PRIVATE="${EXP036_PRIVATE:-$EXP036_MODELS/private}"
export EXP036_WORK="${EXP036_WORK:-$EXP036_MODELS/work}"
export LFA="${LFA:-$(git -C "$EXP" rev-parse --show-toplevel 2>/dev/null)}"
export PY="${PY:-$EXP036_MODELS/venv/bin/python}"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
